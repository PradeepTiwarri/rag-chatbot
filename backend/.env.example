


# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here

# Groq Configuration (for Llama-3-70B and Whisper)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI fallback (if needed)
OPENAI_API_KEY=your_openai_api_key_here

# Backend Configuration
BACKEND_PORT=8000

YOUTUBE_DATA_API_KEY=your_api_key_here

APIFY_API_KEY=your_apify_api_key_here

SERPAPI_API_KEY=your_serpapi_api_key_here

# YouTube bot-check workaround (yt-dlp). Provide ONE of:
# - full contents of a Netscape cookies.txt exported from a logged-in YouTube session
# - or a path to such a file
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_PATH=
# Optional residential proxy if datacenter IPs stay blocked, e.g. http://user:pass@host:port
YTDLP_PROXY=
